# OpenAI-compatible Chat API; include the API version path in the base URL.
# One shared OpenAI key for text agents and GPT Live voice.
API_KEY=
LLM_BASE_URL=
LLM_OUTPUT_MODE=auto
LLM_MODEL=
PORT=3000
DATABASE_PATH=./data/role-cast.sqlite

# Optional GPT Live settings. Uses API_KEY above; no separate voice key.
# Credentials remain on the server. Configuration does not verify model access.
OPENAI_BASE_URL=https://api.openai.com/v1
LIVE_VOICE=marin
