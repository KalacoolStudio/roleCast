{
  "name": "role-cast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node apps/server/src/main.js",
    "build": "vite build --config apps/web/vite.config.js",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "eslint . && prettier --check apps packages scripts tests *.js *.json .env.example README.md",
    "format": "prettier --write apps packages scripts tests *.js *.json README.md"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.48",
    "@fastify/static": "10.1.3",
    "ai": "7.0.99",
    "better-sqlite3": "13.0.3",
    "dotenv": "^17.2.0",
    "fastify": "5.12.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-react": "latest",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "prettier": "^3.8.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
