# Replace all example identities and project settings before applying.
project_id           = "rolecast-example"
region               = "asia-east1"
zone                 = "asia-east1-b"
github_repository    = "KalacoolStudio/roleCast"
github_repository_id = "1366870434"
github_owner_id      = "6670851"
application_users    = ["user:owner@example.com"]
administrators       = ["user:owner@example.com"]

# Enable only to initialize the new empty disk, then apply false after first boot.
initialize_data_disk = true
machine_type         = "e2-small"
data_disk_gb         = 10
backup_retention_days = 30
secret_versions = {
  LLM_API_KEY  = "1"
  LLM_BASE_URL = "1"
  LLM_MODEL    = "1"
}

# Optional Google-hosted HTTPS endpoint; start restricted before selecting access.
https_gateway_enabled = false
https_gateway_access = "restricted" # restricted | iap | anonymous
https_gateway_min_instances = 0
